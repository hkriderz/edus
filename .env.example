# ----------------------------------------------------------------------------
# EDUS Media — environment configuration
#
# IMPORTANT: every value here is NEXT_PUBLIC_*, which means it is inlined into
# the client bundle at BUILD time. Never put a secret in this file. When
# deploying via Docker these must be passed as --build-arg, not runtime -e.
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
# ----------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for metadata, JSON-LD, sitemap.
NEXT_PUBLIC_SITE_URL=https://edusdesigns.com

# Public contact details shown in the header, footer, contact page and JSON-LD.
NEXT_PUBLIC_CONTACT_EMAIL=hello@edusdesigns.com
# E.164 format for tel: links.
NEXT_PUBLIC_CONTACT_PHONE=+19093336812
# Human-readable phone shown to visitors.
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=(909) 333-6812
NEXT_PUBLIC_CONTACT_CITY=Rancho Cucamonga
NEXT_PUBLIC_CONTACT_REGION=CA
NEXT_PUBLIC_CONTACT_COUNTRY=US

# Formspree form ID (the part after /f/ in the endpoint URL).
# Leave blank to disable form submission — the form then shows an
# "email us directly" fallback instead of silently failing.
NEXT_PUBLIC_FORMSPREE_ID=

# Google Tag Manager container ID. Leave blank to omit GTM entirely.
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification token. Leave blank to omit the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
